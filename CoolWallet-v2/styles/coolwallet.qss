QMainWindow,
QWidget {
    background-color: #000000;
    color: #FFFFFF;
    font-family: "Ubuntu";
    font-size: 12pt;
}

QFrame#SideBar {
    background-color: #080808;
    border: 2px solid #00FF66;
    border-radius: 12px;
}

QLabel {
    color: #FFFFFF;
}

QLabel#LogoText {
    color: #00FF66;
    font-size: 24pt;
    font-weight: bold;
}

QLabel#PageTitle {
    color: #FFFFFF;
    font-size: 22pt;
    font-weight: bold;
}

QLabel#NetworkText {
    color: #00FF66;
    font-weight: bold;
}

QPushButton {
    background-color: #111111;
    color: #FFFFFF;
    border: 2px solid #00FF66;
    border-radius: 8px;
    padding: 10px;
    text-align: left;
}

QPushButton:hover {
    background-color: #00AA44;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #007733;
}

QGroupBox {
    background-color: #050505;
    color: #00FF66;
    border: 2px solid #00FF66;
    border-radius: 10px;
    margin-top: 12px;
    padding: 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
}

QLabel#CardLabel {
    color: #FFFFFF;
    font-size: 14pt;
    font-weight: bold;
}
