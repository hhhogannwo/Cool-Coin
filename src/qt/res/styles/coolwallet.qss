QMainWindow {
    background: #101214;
}

QWidget {
    background: #101214;
    color: white;
    font-family: "Segoe UI";
    font-size: 11pt;
}

QFrame#SideBar {
    background: #181C22;
}

QPushButton {
    background: transparent;
    color: white;
    border: none;
    padding: 12px;
    text-align: left;
}

QPushButton:hover {
    background: #22C55E;
    color: black;
}

QGroupBox {
    border: 1px solid #22C55E;
    border-radius: 10px;
    margin-top: 10px;
    padding: 10px;
}

QLabel#BalanceValue {
    font-size: 22pt;
    font-weight: bold;
    color: #22C55E;
}
